[Unit]
Description=OwO Blackjack Companion (read-only advisor)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=owobot
Group=owobot
WorkingDirectory=/opt/owo-blackjack-companion
EnvironmentFile=/etc/owo-blackjack-companion.env
ExecStart=/usr/bin/node /opt/owo-blackjack-companion/bot.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
