# Discord bot token. Never commit a real token.
DISCORD_TOKEN=replace_with_your_bot_token

# The OwO bot's public application ID. Verify this is the exact ID in your server.
OWO_BOT_ID=408785106942164992

# Optional comma-separated text-channel IDs. Leave blank and use /owo in the
# channel to activate the companion. The first version supports only one active
# OwO blackjack game per channel.
TRACK_CHANNEL_IDS=

# Optional: post advice in a separate channel. Leave blank to use the source channel.
ADVICE_CHANNEL_ID=

# Stop tracking if OwO does not edit the game message for this many milliseconds.
SESSION_IDLE_MS=90000

# Deployment gate. Leave false until the real OwO embed format, Message Content
# Intent, and OwO's permission for this read-only assistant have been verified.
# When false, the bot runs in setup mode: it registers /owo but refuses live
# tracking. This flag is an acknowledgement, not a substitute for permission.
ALLOW_LIVE_OWO=false
